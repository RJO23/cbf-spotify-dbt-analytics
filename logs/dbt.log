WITH raw_tracks AS (
    SELECT 
        track_id,
        -- Note: Update 'artists' to 'artist_names' if that's what you named it in staging yesterday!
        artists 
    FROM `rhys-project-485811`.`dbt_rhys_spotify`.`stg_tracks`
    WHERE artists IS NOT NULL
),

split_artists AS (
    SELECT 
        track_id,
        -- 1. Replace semicolons with commas
        -- 2. Split the string into an array
        SPLIT(REPLACE(artists, ';', ','), ',') AS artist_array
    FROM raw_tracks
),

flattened_artists AS (
    SELECT 
        track_id,
        -- 3. Clean up any trailing spaces
        TRIM(artist_name) AS artist_name
    FROM split_artists,
    UNNEST(split_artists.artist_array) AS artist_name
)

SELECT 
    track_id,
    artist_name
FROM flattened_artists
-- 4. Defensive check to drop empty strings
WHERE artist_name != '';


