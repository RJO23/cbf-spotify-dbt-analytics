[0m14:56:40.624486 [debug] [Thread-3 (]: On model.spotify_analytics.int_track_deduped: /* {"app": "dbt", "dbt_version": "1.11.5", "profile_name": "spotify_analytics", "target_name": "dev", "node_id": "model.spotify_analytics.int_track_deduped"} */

  
    

    create or replace table `rhys-project-485811`.`dbt_rhys_spotify`.`int_track_deduped`
      
    
    

    
    OPTIONS()
    as (
      

WITH staged_tracks AS (
    SELECT * FROM `rhys-project-485811`.`dbt_rhys_spotify`.`stg_tracks`
),

enriched_tracks AS (
    SELECT
        *, -- Grabs all the base columns from staging
        
        -- Popularity Buckets
        CASE
            WHEN popularity >= 80 THEN 'High'
            WHEN popularity >= 50 THEN 'Medium'
            ELSE 'Low'
        END AS popularity_bucket,

        -- Duration Categories
        CASE
            WHEN duration_minutes < 3.0 THEN 'Short (< 3 mins)'
            WHEN duration_minutes <= 5.0 THEN 'Standard (3-5 mins)'
            ELSE 'Long (> 5 mins)'
        END AS duration_category,

        -- Tempo Groupings
        CASE
            WHEN tempo >= 120.0 THEN 'Fast'
            WHEN tempo >= 90.0 THEN 'Medium'
            ELSE 'Slow'
        END AS tempo_category

    FROM staged_tracks
)

-- Select the enriched data and apply the deduplication filter
SELECT * FROM enriched_tracks
QUALIFY ROW_NUMBER() OVER (
    PARTITION BY track_id 
    ORDER BY popularity DESC
) = 1
    );
  
