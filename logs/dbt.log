[0m15:46:56.105020 [debug] [Thread-1 (]: On model.spotify_analytics.dim_artists: /* {"app": "dbt", "dbt_version": "1.11.5", "profile_name": "spotify_analytics", "target_name": "dev", "node_id": "model.spotify_analytics.dim_artists"} */

  
    

    create or replace table `rhys-project-485811`.`dbt_rhys_spotify`.`dim_artists`
      
    
    

    
    OPTIONS()
    as (
      

WITH raw_artists AS (
    SELECT DISTINCT 
        SPLIT(REPLACE(artist_names, ';', ','), ',') AS artist_array
    FROM `rhys-project-485811`.`dbt_rhys_spotify`.`int_tracks_enriched`
    WHERE artist_names IS NOT NULL
),

flattened_artists AS (
    SELECT DISTINCT
        TRIM(artist_name) AS artist_name
    FROM raw_artists,
    UNNEST(raw_artists.artist_array) AS artist_name
)

SELECT 
    GENERATE_UUID() AS artist_id,
    artist_name
FROM flattened_artists
WHERE TRIM(artist_name) != ''
    );
  
