[0m15:44:39.553964 [debug] [Thread-1 (]: On model.spotify_analytics.dim_artists: /* {"app": "dbt", "dbt_version": "1.11.5", "profile_name": "spotify_analytics", "target_name": "dev", "node_id": "model.spotify_analytics.dim_artists"} */

  
    

    create or replace table `rhys-project-485811`.`dbt_rhys_spotify`.`dim_artists`
      
    
    

    
    OPTIONS()
    as (
      

WITH raw_artists AS (
    SELECT DISTINCT 
        
        split(artist_names, ';') as artist_array
    FROM `rhys-project-485811`.`dbt_rhys_spotify`.`int_tracks_enriched`
    WHERE artist_names IS NOT NULL
),

flattened_artists AS (
    SELECT DISTINCT
        
        trim(artist_name) as artist_name
    FROM raw_artists,
    UNNEST(raw_artists.artist_array) AS artist_name
)

SELECT 
    
    generate_uuid() as artist_id,
    artist_name
FROM flattened_artists
WHERE artist_name != ''
    );
  
