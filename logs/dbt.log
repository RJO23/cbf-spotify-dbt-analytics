  create or replace view `rhys-project-485811`.`dbt_rhys_spotify`.`int_track_duplicate_analysis`
  OPTIONS()
  as 

WITH track_metrics AS (
    SELECT 
        track_id,
        COUNT(*) AS row_count,
        -- Note: change 'genre_name' to 'genre' if that's what you named it in staging!
        COUNT(DISTINCT genre_name) AS genre_count,
        MIN(popularity) AS min_popularity,
        MAX(popularity) AS max_popularity
    FROM `rhys-project-485811`.`dbt_rhys_spotify`.`stg_tracks`
    GROUP BY track_id
)

SELECT 
    track_id,
    row_count,
    genre_count,
    min_popularity,
    max_popularity
FROM track_metrics
-- Optional: We only really care about the duplicates, so let's filter for them
WHERE row_count > 1
ORDER BY row_count DESC;


