    create or replace table `rhys-project-485811`.`dbt_rhys_spotify`.`fact_track_artist_metrics`
      
    
    

    
    OPTIONS()
    as (
      

SELECT
    to_hex(md5(cast(coalesce(cast(t.track_id as string), '_dbt_utils_surrogate_key_null_') as string)))  AS track_key,
    to_hex(md5(cast(coalesce(cast(a.artist_name as string), '_dbt_utils_surrogate_key_null_') as string)))  AS artist_key,
    
    t.track_id,
    t.popularity,
    t.danceability,
    t.energy,
    t.tempo
FROM `rhys-project-485811`.`dbt_rhys_spotify`.`int_track_deduped` AS t
JOIN `rhys-project-485811`.`dbt_rhys_spotify`.`int_tracks_artists` AS a
    ON t.track_id = a.track_id
    );
  
