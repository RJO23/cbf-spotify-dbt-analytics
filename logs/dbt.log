  create or replace view `rhys-project-485811`.`dbt_rhys_spotify`.`int_tracks_artists`
  OPTIONS()
  as 

WITH raw_tracks AS (
    SELECT 
        track_id,
        artist_names -- FIXED: using your actual column name
    FROM `rhys-project-485811`.`dbt_rhys_spotify`.`stg_tracks`
    WHERE artist_names IS NOT NULL -- FIXED
),

split_artists AS (
    SELECT 
        track_id,
        -- FIXED: passing the correct column into the REPLACE function
        SPLIT(REPLACE(artist_names, ';', ','), ',') AS artist_array
    FROM raw_tracks
),

flattened_artists AS (
    SELECT 
        track_id,
        TRIM(artist_name) AS artist_name
    FROM split_artists,
    UNNEST(split_artists.artist_array) AS artist_name
)

SELECT 
    track_id,
    artist_name
FROM flattened_artists
WHERE artist_name != '';


