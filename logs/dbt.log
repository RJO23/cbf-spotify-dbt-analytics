  create or replace view `rhys-project-485811`.`dbt_rhys_spotify`.`int_track_duplicate_analysis`
  OPTIONS()
  as 

WITH track_metrics AS (
    SELECT 
        track_id,
        COUNT(*) AS row_count,
        COUNT(DISTINCT track_genre) AS genre_count,
        MIN(popularity) AS min_popularity,
        MAX(popularity) AS max_popularity
    FROM `rhys-project-485811`.`dbt_rhys_spotify`.`stg_tracks`
    GROUP BY track_id
)

SELECT 
    track_id,
    row_count,
    genre_count,
    min_popularity,
    max_popularity
FROM track_metrics
WHERE row_count > 1
ORDER BY row_count DESC;


[0m15:44:35.507549 [debug] [Thread-2 (]: On model.spotify_analytics.int_tracks_artists: /* {"app": "dbt", "dbt_version": "1.11.5", "profile_name": "spotify_analytics", "target_name": "dev", "node_id": "model.spotify_analytics.int_tracks_artists"} */


  create or replace view `rhys-project-485811`.`dbt_rhys_spotify`.`int_tracks_artists`
  OPTIONS()
  as 

WITH raw_tracks AS (
    SELECT 
        track_id,
        artist_names
    FROM `rhys-project-485811`.`dbt_rhys_spotify`.`stg_tracks`
    WHERE artist_names IS NOT NULL
),

-- I've moved the unesting logic here from dim_artists (deleted) and kept the track_id so a single song can still be credited to two artists and a seperate row can be made for each.

split_artists AS (
    SELECT 
        track_id,
        SPLIT(REPLACE(artist_names, ';', ','), ',') AS artist_array
    FROM raw_tracks
),

flattened_artists AS (
    SELECT 
        track_id,
        TRIM(artist_name) AS artist_name
    FROM split_artists,
    UNNEST(split_artists.artist_array) AS artist_name
)

SELECT 
    track_id,
    artist_name
FROM flattened_artists
WHERE artist_name != '';


